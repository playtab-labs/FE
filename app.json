{
  "expo": {
    "name": "Playtab",
    "slug": "Playtab",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "playtab",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
